ID_DIALOG_CONFIGURE_CRT DIALOGEX 0, 0, 260, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configure CRT Filter"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Enable CRT filter",IDC_CRT_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,7,100,10
    GROUPBOX        "Filter settings",IDC_STATIC,7,22,246,130
    RTEXT           "Scanline hardness",IDC_STATIC,12,39,72,8
    CONTROL         "",IDC_CRT_HARD_SCAN,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,88,36,120,15
    LTEXT           "",IDC_CRT_HARD_SCAN_VALUE,212,39,36,8
    RTEXT           "Pixel hardness",IDC_STATIC,12,57,72,8
    CONTROL         "",IDC_CRT_HARD_PIX,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,88,54,120,15
    LTEXT           "",IDC_CRT_HARD_PIX_VALUE,212,57,36,8
    RTEXT           "Horizontal warp",IDC_STATIC,12,75,72,8
    CONTROL         "",IDC_CRT_WARP_H,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,88,72,120,15
    LTEXT           "",IDC_CRT_WARP_H_VALUE,212,75,36,8
    RTEXT           "Vertical warp",IDC_STATIC,12,93,72,8
    CONTROL         "",IDC_CRT_WARP_V,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,88,90,120,15
    LTEXT           "",IDC_CRT_WARP_V_VALUE,212,93,36,8
    RTEXT           "Mask dark",IDC_STATIC,12,111,72,8
    CONTROL         "",IDC_CRT_MASK_DARK,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,88,108,120,15
    LTEXT           "",IDC_CRT_MASK_DARK_VALUE,212,111,36,8
    RTEXT           "Mask light",IDC_STATIC,12,129,72,8
    CONTROL         "",IDC_CRT_MASK_LIGHT,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,88,126,120,15
    LTEXT           "",IDC_CRT_MASK_LIGHT_VALUE,212,129,36,8
    PUSHBUTTON      "Defaults",IDC_CRT_DEFAULTS,7,159,50,14
    DEFPUSHBUTTON   "OK",IDOK,149,159,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,203,159,50,14
END

